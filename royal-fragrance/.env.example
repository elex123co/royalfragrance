# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only. Never expose to the client.

# ── Payment provider (choose the active one) ───────────────────────────────
PAYMENT_PROVIDER=paystack        # paystack | monnify

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Bank slug for vendor Dedicated Virtual Accounts. Use "test-bank" only
# with a test secret key; use a real slug (e.g. wema-bank) with a live key.
PAYSTACK_PREFERRED_BANK=wema-bank

# Monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Until a custom domain is verified in Resend, leave this unset — it
# defaults to onboarding@resend.dev, which can only deliver to the email
# address that owns the Resend account (sandbox restriction).
RESEND_FROM_EMAIL=

# ── AI Assistant "Elizabeth" (Groq) ─────────────────────────────────────
GROQ_API_KEY=
